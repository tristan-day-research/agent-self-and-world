# The shared workflow already defaults to remote_requirements.txt and python run.py.
# Override only the results root so pull-results does not fetch experiment code.
RESULTS_SUBDIR="outputs"
# Shared pull script mirrors this path instead of creating a second results tree.
PULL_LAYOUT="mirror"
# Reports are authored locally after reviewing pulled evidence. Old pod-generated
# report.md files must not overwrite a locally authored report on default pulls.
RESULTS_EXCLUDE="report.md"
